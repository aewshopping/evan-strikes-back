49]},{"filepath":"src/003 Robot fix.md","filename":"003 Robot fix.md","timestamp":"2026-10-04T09:59:29.012Z","event":"close","lineRefs":[0,30,31,136,4,5,6,33,34,35,9,36,37,38,11,39,40,41,15,16,17,123,0,19,42,19,43,19,44,19,45,19,46,19,47,19,48,19,49]},{"filepath":"src/004 Bodge job.md","filename":"004 Bodge job.md","timestamp":"2026-10-04T09:59:36.177Z","event":"close","lineRefs":[0,73,74,75,4,5,6,76,9,25,11,77,15,16,17,123,0,19,78,19,79,19,80,19,81,19,82,19,83,19,84,19,85,19,86,19,87,19,88,19,89,19,90,19,91,19,92,19,93]},{"filepath":"src/005 Gibberish.md","filename":"005 Gibberish.md","timestamp":"2026-10-04T09:59:38.042Z","event":"open","lineRefs":[0,21,22,137,4,5,6,24,9,25,11,26,15,16,17,0,27]},{"filepath":"src/006 Activating the robot.md","filename":"006 Activating the robot.md","timestamp":"2026-10-04T09:59:42.037Z","event":"open","lineRefs":[0,138,1,2,4,5,6,7,8,9,139,140,11,51,56,15,16,17,0,18,19,19]},{"filepath":"src/009 secret message.txt","filename":"009 secret message.txt","timestamp":"2026-10-04T10:00:30.386Z","event":"open","lineRefs":[0,65,11,62,15,16,17,141,4,142,9,143,0,19,19]},{"filepath":"src/011 brush teeth.txt","filename":"011 brush teeth.txt","timestamp":"2026-10-04T10:01:29.774Z","event":"open","lineRefs":[0,68,11,57,15,16,17,144,4,145,9,146,0,19,19]},{"filepath":"src/008 teeth brush.txt","filename":"008 teeth brush.txt","timestamp":"2026-10-04T13:54:38.142Z","event":"open","lineRefs":[0,68,19,71,72,4,5,6,7,19,11,58,15,16,17,9,147,0,19,19]},{"filepath":"src/003 Robot fix.md","filename":"003 Robot fix.md","timestamp":"2026-10-04T13:57:18.085Z","event":"close","lineRefs":[0,30,31,136,4,5,6,148,34,35,9,36,37,38,11,149,40,41,15,16,17,123,0,19,42,19,43,19,44,19,45,19,150,19,47,19,48,19,49]},{"filepath":"src/005 Gibberish.md","filename":"005 Gibberish.md","timestamp":"2026-10-04T13:57:32.326Z","event":"close","lineRefs":[0,21,22,137,4,5,6,24,9,25,11,26,15,16,17,0,151]}]}